# ============================================================
# Gazameel — قالب البيئة (انسخه إلى .env.local)
# ============================================================
# الأمر:  cp .env.example .env.local
# ثم الصق القيم الحقيقية — لا تخترع مفاتيح.
# بدون المفاتيح تعمل واجهة المعاينة برسائل ودّية.
#
# الدروس:
#   docs/درس-المرحلة-1.md  ← Supabase + Google + Storage
#   docs/درس-المرحلة-2.md  ← تيليجرام + كويز + تذكيرات
#   docs/درس-المرحلة-3.md  ← مجتمع (واتساب / مساهمون / استطلاعات)
# ============================================================

# ---------- مرحلة 1: مطلوب ----------
# من Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# service_role سرّي — سيرفر فقط (رفع، موافقة، Signed URL، cron)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# اتصال Postgres المباشر (اختياري — التطبيق نفسه يمر عبر PostgREST لا هنا)
# Supabase → Project Settings → Database → Connection Pooling
#
# 6543 = Transaction mode → للاستعلامات القصيرة من بيئات Serverless
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# 5432 = Session mode → للترحيلات (migrations) وأي أداة تحتاج
# prepared statements أو معاملات طويلة (Prisma migrate، psql، pg_dump)
# لا تُشغّل ترحيلات على 6543 — ستفشل عند أول prepared statement.
DATABASE_URL=
DIRECT_URL=

# بريدك على Google → يُرقّى تلقائيًا إلى is_admin
ADMIN_EMAIL=you@gmail.com

# عنوان التطبيق (طابق المنفذ المحلي أو رابط Vercel)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# ---------- مرحلة 3: اختياري ----------
# رابط دعوة مجموعة واتساب
NEXT_PUBLIC_WHATSAPP_URL=
# بريد تواصل يظهر في لوحة الأدمن (مثل info@...)
NEXT_PUBLIC_CONTACT_EMAIL=
# إرسال الإعلانات الجماعية عبر Resend (أسرار سيرفر فقط)
RESEND_API_KEY=
# مثال بعد توثيق الدومين في Resend: Gazameel <news@your-domain.com>
BROADCAST_EMAIL_FROM=

# ---------- مرحلة 2: اختياري (اتركه فارغًا حتى تجهّز البوت) ----------
# من @BotFather — بعد اللصق: npm run telegram:setup ثم npm run telegram:poll
TELEGRAM_BOT_TOKEN=
# رقم chat_id الخاص بك كأدمن (من /whoami في البوت)
ADMIN_TELEGRAM_CHAT_ID=
# اسم المستخدم بدون @ (يملأه telegram:setup تلقائيًا)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# سرّ webhook عند setWebhook (مستحسن على الإنتاج)
TELEGRAM_WEBHOOK_SECRET=

# ---------- حماية Cron على Vercel ----------
# غيّر القيمة إلى سرّ عشوائي قوي قبل النشر
CRON_SECRET=change-me
